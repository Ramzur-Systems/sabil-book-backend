#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python manage.py migrate
# Plain `runserver`, not `runserver_plus`: with `daphne` installed, Channels
# takes over this command to serve ASGI (HTTP + WebSocket) instead of WSGI.
# runserver_plus replaces the command with its own WSGI-only dev server,
# which would silently drop WebSocket support.
exec python manage.py runserver 0.0.0.0:8000
