# Private result attachments (SeaweedFS). Read by Django, Celery and SeaweedFS,
# so the app key and the server's only identity always match.
# Local-only development credentials; never reuse them in production.
ATTACHMENT_S3_BUCKET=sabil-book-results
ATTACHMENT_S3_ENDPOINT_URL=http://seaweedfs:8333
ATTACHMENT_S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ACCESS_KEY=local-dev-attachments
ATTACHMENT_S3_SECRET_KEY=local-dev-attachments-secret-change-me
